rules_version = '2';

// AR 寵物召喚：Firestore 安全規則
// 貼到 Firebase 主控台 → Firestore Database →「規則」分頁，取代原本全部內容，按「發布」。
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      function isMe() { return request.auth != null && request.auth.uid == uid; }

      // 只有伺服器（之後的付款驗證雲端函式）能改的欄位
      function noServerFields() {
        return !request.resource.data.keys().hasAny(['slots', 'owned', 'purchases']);
      }
      function serverFieldsUnchanged() {
        return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['slots', 'owned', 'purchases']);
      }

      // 飼料：第一次只能拿到 5 包；之後只能減少（吃掉），不能自己加
      function foodOkOnCreate() {
        return !('food' in request.resource.data) || request.resource.data.food == 5;
      }
      function foodOkOnUpdate() {
        return ('food' in resource.data)
          ? ('food' in request.resource.data
             && request.resource.data.food is int
             && request.resource.data.food >= 0
             && request.resource.data.food <= resource.data.food)
          : (!('food' in request.resource.data) || request.resource.data.food == 5);
      }

      allow read: if isMe();
      allow create: if isMe() && noServerFields() && foodOkOnCreate();
      allow update: if isMe() && serverFieldsUnchanged() && foodOkOnUpdate();
      allow delete: if isMe();   // 刪除帳號用
    }
  }
}
